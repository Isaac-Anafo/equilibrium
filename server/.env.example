DB_URL=jdbc:postgresql://<host>:5432/<database>?sslmode=require
DB_USERNAME=<db-user>
DB_PASSWORD=<db-password>
JWT_SECRET=<random-long-secret>
PORT=8080
CORS_ORIGINS=http://localhost:5173,http://localhost:8443,https://equilibrium-umber.vercel.app
# Email (password reset). SMTP_HOST blank => reset link is logged, not emailed.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=<smtp-user>
SMTP_PASSWORD=<smtp-password>
MAIL_FROM=no-reply@equilibrium.app
# Public origin of the client app; reset emails link to {FRONTEND_URL}/reset-password?token=...
FRONTEND_URL=http://localhost:8443
# AI assistant (chat). CHAT_ENABLED=false or missing key => chat reports "not configured".
# The endpoint is OpenAI-compatible, so it can point at OpenAI or Groq.
# For Groq: CHAT_BASE_URL=https://api.groq.com/openai/v1/chat/completions, OPENAI_API_KEY=<groq key>,
# and OPENAI_MODEL=llama-3.1-8b-instant (fastest) or llama-3.3-70b-versatile (flagship).
CHAT_ENABLED=true
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
CHAT_BASE_URL=https://api.openai.com/v1/chat/completions
